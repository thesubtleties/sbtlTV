{
  "name": "@sbtltv/electron",
  "version": "0.11.0",
  "description": "Desktop IPTV player with mpv",
  "homepage": "https://github.com/thesubtleties/sbtlTV",
  "author": {
    "name": "thesubtleties",
    "email": "thesubtleties@users.noreply.github.com"
  },
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/bundle-data.mjs",
    "dev": "electron . --dev",
    "start": "electron .",
    "test": "tsc && node scripts/bundle-data.mjs && node --experimental-vm-modules --test dist/gpu-selection.test.js dist/preload-shared-texture.test.js dist/mpv-texture-bridge.test.js dist/data/schema.test.js dist/data/queries.test.js dist/data/writes.test.js dist/data/epg-source.test.js dist/data/sync-stages.test.js dist/data/scheduler.test.js dist/data/router.test.js dist/data/lanes.test.js dist/linux-player-mode.test.js",
    "test:playback": "electron tests/native-playback.cjs",
    "typecheck": "tsc --noEmit",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@sbtltv/core": "workspace:*",
    "@sbtltv/local-adapter": "workspace:*",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.7.3"
  },
  "optionalDependencies": {
    "@sbtltv/mpv-texture": "workspace:*"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.4.0",
    "esbuild": "^0.27.2",
    "typescript": "^5.3.0"
  }
}
